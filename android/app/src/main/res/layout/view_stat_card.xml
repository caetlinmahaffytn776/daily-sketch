<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/stat_card"
        style="@style/Widget.App.Card.Stat"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/gap_s"
            android:paddingTop="@dimen/gap_s"
            android:paddingEnd="@dimen/gap_s"
            android:paddingBottom="@dimen/gap_s">

            <View
                android:id="@+id/stat_accent"
                android:layout_width="@dimen/accent_dot"
                android:layout_height="@dimen/accent_dot"
                android:background="@drawable/bg_accent_dot" />

            <TextView
                android:id="@+id/stat_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_xs"
                android:accessibilityLiveRegion="polite"
                android:textAppearance="@style/TextAppearance.App.Stat" />

            <TextView
                android:id="@+id/stat_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:maxLines="2"
                android:textAppearance="@style/TextAppearance.App.Eyebrow" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</merge>
