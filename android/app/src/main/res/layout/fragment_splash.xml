<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/splash_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_splash_gradient">

    <ImageView
        android:id="@+id/splash_art"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:alpha="0.22"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_splash"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/splash_dot_one"
        android:layout_width="@dimen/splash_dot_mid"
        android:layout_height="@dimen/splash_dot_mid"
        android:layout_marginStart="54dp"
        android:alpha="0.35"
        android:background="@drawable/shape_ink_dot"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.18" />

    <View
        android:id="@+id/splash_dot_two"
        android:layout_width="@dimen/splash_dot_large"
        android:layout_height="@dimen/splash_dot_large"
        android:layout_marginEnd="38dp"
        android:alpha="0.2"
        android:background="@drawable/shape_ink_dot"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.42" />

    <View
        android:id="@+id/splash_dot_three"
        android:layout_width="@dimen/splash_dot_small"
        android:layout_height="@dimen/splash_dot_small"
        android:layout_marginStart="76dp"
        android:alpha="0.5"
        android:background="@drawable/shape_ink_dot"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.74" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/splash_mark_card"
        android:layout_width="@dimen/splash_mark"
        android:layout_height="@dimen/splash_mark"
        app:cardBackgroundColor="@color/paper"
        app:cardCornerRadius="26dp"
        app:cardElevation="0dp"
        app:layout_constraintBottom_toTopOf="@id/splash_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        app:strokeColor="@color/sand"
        app:strokeWidth="2dp">

        <ImageView
            android:id="@+id/splash_mark"
            android:layout_width="@dimen/splash_mark_inner"
            android:layout_height="@dimen/splash_mark_inner"
            android:layout_gravity="center"
            android:contentDescription="@string/cd_splash_mark"
            android:scaleType="fitCenter"
            android:src="@drawable/sprite_pencil" />

    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/splash_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/gap_xl"
        android:text="@string/splash_wordmark"
        android:textAppearance="@style/TextAppearance.App.Display"
        app:layout_constraintBottom_toTopOf="@id/splash_subtitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/splash_mark_card" />

    <TextView
        android:id="@+id/splash_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/gap_s"
        android:text="@string/splash_subtitle"
        android:textAppearance="@style/TextAppearance.App.Eyebrow.Splash"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/splash_title" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/splash_progress"
        android:layout_width="@dimen/splash_indicator_width"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/gap_m"
        android:indeterminate="true"
        app:indicatorColor="@color/terracotta"
        app:layout_constraintBottom_toTopOf="@id/splash_loading"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:trackColor="@color/splash_track"
        app:trackCornerRadius="2dp"
        app:trackThickness="3dp" />

    <TextView
        android:id="@+id/splash_loading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:accessibilityLiveRegion="polite"
        android:layout_marginBottom="@dimen/gap_s"
        android:text="@string/splash_loading"
        android:textAppearance="@style/TextAppearance.App.Eyebrow.Loading"
        app:layout_constraintBottom_toTopOf="@id/splash_footer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/splash_footer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/gap_xl"
        android:textColor="@color/splash_footer"
        android:text="@string/splash_footer"
        android:textSize="10sp"
        android:letterSpacing="0.2"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
