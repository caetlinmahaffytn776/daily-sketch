<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/game_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_game_gradient">

    <ImageView
        android:id="@+id/game_art"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:alpha="0.14"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_game"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/game_header_bg"
        android:layout_width="0dp"
        android:layout_height="92dp"
        android:background="@drawable/shape_header_surface"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/game_back"
        style="@style/Widget.App.Button.Icon"
        android:layout_width="@dimen/touch_min"
        android:layout_height="@dimen/touch_min"
        android:layout_marginStart="@dimen/gap_s"
        android:contentDescription="@string/cd_back"
        app:icon="@drawable/ic_back"
        app:layout_constraintBottom_toBottomOf="@id/game_header_bg"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/game_header_bg"
        app:layout_constraintVertical_bias="1.0" />

    <TextView
        android:id="@+id/game_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/game_header_title"
        android:textAppearance="@style/TextAppearance.App.Wordmark.Header"
        app:layout_constraintBottom_toBottomOf="@id/game_back"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/game_back" />

    <TextView
        android:id="@+id/game_elapsed"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/screen_margin"
        android:accessibilityLiveRegion="polite"
        android:text="@string/game_elapsed_initial"
        android:textAppearance="@style/TextAppearance.App.Stat.Timer"
        app:layout_constraintBottom_toBottomOf="@id/game_back"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/game_back" />

    <View
        android:id="@+id/game_header_rule"
        style="@style/Widget.App.Hairline"
        android:layout_width="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/game_header_bg" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/game_scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingStart="@dimen/screen_margin"
        android:paddingTop="@dimen/gap_m"
        android:paddingEnd="@dimen/screen_margin"
        android:paddingBottom="@dimen/gap_m"
        app:layout_constraintBottom_toTopOf="@id/game_error"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/game_header_rule">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/game_prompt_card"
                style="@style/Widget.App.Card.Paper"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingTop="@dimen/gap_s"
                    android:paddingBottom="@dimen/gap_s">

                    <View
                        android:layout_width="@dimen/rule_width"
                        android:layout_height="match_parent"
                        android:layout_marginStart="@dimen/gap_s"
                        android:background="@drawable/shape_left_rule" />

                    <TextView
                        android:id="@+id/game_prompt"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:paddingStart="@dimen/gap_s"
                        android:paddingEnd="@dimen/gap_s"
                        android:textAppearance="@style/TextAppearance.App.Prompt.Compact" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/game_eyebrow_mood"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_m"
                android:text="@string/game_eyebrow_mood"
                android:textAppearance="@style/TextAppearance.App.Eyebrow" />

            <LinearLayout
                android:id="@+id/game_mood_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_xs"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/mood_smooth"
                    style="@style/Widget.App.Chip.Choice"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/chip_height"
                    android:layout_marginEnd="@dimen/gap_xxs"
                    android:layout_weight="1"
                    android:text="@string/mood_smooth" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/mood_messy"
                    style="@style/Widget.App.Chip.Choice"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/chip_height"
                    android:layout_marginStart="@dimen/gap_xxs"
                    android:layout_marginEnd="@dimen/gap_xxs"
                    android:layout_weight="1"
                    android:text="@string/mood_messy" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/mood_proud"
                    style="@style/Widget.App.Chip.Choice"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/chip_height"
                    android:layout_marginStart="@dimen/gap_xxs"
                    android:layout_marginEnd="@dimen/gap_xxs"
                    android:layout_weight="1"
                    android:text="@string/mood_proud" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/mood_stuck"
                    style="@style/Widget.App.Chip.Choice"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/chip_height"
                    android:layout_marginStart="@dimen/gap_xxs"
                    android:layout_weight="1"
                    android:text="@string/mood_stuck" />

            </LinearLayout>

            <TextView
                android:id="@+id/game_eyebrow_notes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_m"
                android:text="@string/game_eyebrow_notes"
                android:textAppearance="@style/TextAppearance.App.Eyebrow" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_xs">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/game_notes_layout"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/game_notes_hint"
                    app:boxCornerRadiusBottomEnd="@dimen/card_radius"
                    app:boxCornerRadiusBottomStart="@dimen/card_radius"
                    app:boxCornerRadiusTopEnd="@dimen/card_radius"
                    app:boxCornerRadiusTopStart="@dimen/card_radius"
                    app:boxStrokeColor="@color/stroke_sand"
                    app:counterEnabled="true"
                    app:counterMaxLength="240">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/game_notes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="top|start"
                        android:inputType="textMultiLine|textCapSentences"
                        android:maxLines="6"
                        android:minLines="4"
                        android:paddingEnd="@dimen/gap_xl"
                        android:paddingStart="@dimen/gap_s"
                        android:textColor="@color/ink"
                        android:textSize="15sp" />

                </com.google.android.material.textfield.TextInputLayout>

                <ImageView
                    android:id="@+id/game_sprite"
                    android:layout_width="@dimen/sprite_game"
                    android:layout_height="@dimen/sprite_game"
                    android:layout_gravity="bottom|end"
                    android:layout_marginEnd="10dp"
                    android:layout_marginBottom="10dp"
                    android:alpha="0.9"
                    android:contentDescription="@string/cd_game_sprite"
                    android:scaleType="fitCenter"
                    android:src="@drawable/sprite_palette" />

            </FrameLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <TextView
        android:id="@+id/game_error"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/screen_margin"
        android:layout_marginEnd="@dimen/screen_margin"
        android:layout_marginBottom="@dimen/gap_xs"
        android:accessibilityLiveRegion="polite"
        android:background="@drawable/shape_error_strip"
        android:gravity="center"
        android:paddingTop="@dimen/gap_xs"
        android:paddingBottom="@dimen/gap_xs"
        android:text="@string/game_error"
        android:textAppearance="@style/TextAppearance.App.Eyebrow"
        android:textColor="@color/terracotta_deep"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/game_controls"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <LinearLayout
        android:id="@+id/game_controls"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/shape_controls_surface"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_margin"
        android:paddingTop="@dimen/gap_m"
        android:paddingEnd="@dimen/screen_margin"
        android:paddingBottom="@dimen/controls_bottom_pad"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/game_eyebrow_minutes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/game_eyebrow_minutes"
            android:textAppearance="@style/TextAppearance.App.Eyebrow" />

        <LinearLayout
            android:id="@+id/game_minutes_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_xs"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/minutes_five"
                style="@style/Widget.App.Chip.Choice"
                android:layout_width="0dp"
                android:layout_height="@dimen/chip_height"
                android:layout_marginEnd="@dimen/gap_xxs"
                android:layout_weight="1"
                android:text="@string/minutes_five" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/minutes_ten"
                style="@style/Widget.App.Chip.Choice"
                android:layout_width="0dp"
                android:layout_height="@dimen/chip_height"
                android:layout_marginStart="@dimen/gap_xxs"
                android:layout_marginEnd="@dimen/gap_xxs"
                android:layout_weight="1"
                android:text="@string/minutes_ten" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/minutes_twenty"
                style="@style/Widget.App.Chip.Choice"
                android:layout_width="0dp"
                android:layout_height="@dimen/chip_height"
                android:layout_marginStart="@dimen/gap_xxs"
                android:layout_marginEnd="@dimen/gap_xxs"
                android:layout_weight="1"
                android:text="@string/minutes_twenty" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/minutes_thirty"
                style="@style/Widget.App.Chip.Choice"
                android:layout_width="0dp"
                android:layout_height="@dimen/chip_height"
                android:layout_marginStart="@dimen/gap_xxs"
                android:layout_weight="1"
                android:text="@string/minutes_thirty" />

        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/game_cta"
            style="@style/Widget.App.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height_primary"
            android:layout_marginTop="14dp"
            android:text="@string/game_cta"
            app:icon="@drawable/ic_check"
            app:iconTint="@color/on_terracotta" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/game_discard"
            style="@style/Widget.App.Button.Text"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height_text"
            android:layout_marginTop="@dimen/gap_s"
            android:text="@string/game_discard" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
