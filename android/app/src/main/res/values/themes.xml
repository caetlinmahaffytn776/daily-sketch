<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.DailySketch" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/terracotta</item>
        <item name="colorOnPrimary">@color/on_terracotta</item>
        <item name="colorPrimaryContainer">@color/terracotta_tint</item>
        <item name="colorOnPrimaryContainer">@color/ink</item>
        <item name="colorSecondary">@color/plum</item>
        <item name="colorOnSecondary">@color/paper</item>
        <item name="colorSecondaryContainer">@color/plum_tint</item>
        <item name="colorOnSecondaryContainer">@color/ink</item>
        <item name="colorTertiary">@color/sand</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="colorSurfaceVariant">@color/paper_warm</item>
        <item name="colorOnSurfaceVariant">@color/ink_soft</item>
        <item name="colorOutline">@color/stroke_warm</item>
        <item name="colorOutlineVariant">@color/stroke_sand</item>
        <item name="colorError">@color/terracotta_deep</item>
        <item name="android:colorBackground">@color/paper</item>
        <item name="colorOnBackground">@color/ink</item>
        <item name="android:windowBackground">@drawable/bg_launch_window</item>
        <item name="android:statusBarColor">@color/paper_warm</item>
        <item name="android:navigationBarColor">@color/paper_warm</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/ink_soft</item>
        <item name="android:textColorHint">@color/ink_muted</item>
    </style>

    <style name="Dialog.App.Settings" parent="Theme.Material3.Light.Dialog">
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:statusBarColor">@color/paper_warm</item>
        <item name="android:navigationBarColor">@color/paper_warm</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="colorPrimary">@color/terracotta</item>
        <item name="colorOnPrimary">@color/on_terracotta</item>
        <item name="colorSecondary">@color/plum</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="colorOutline">@color/stroke_warm</item>
        <item name="colorError">@color/terracotta_deep</item>
        <item name="android:textColorPrimary">@color/ink</item>
    </style>
</resources>
